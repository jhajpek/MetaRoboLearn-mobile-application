    "expo-navigation-bar": "~4.0.9",
    "expo-screen-orientation": "~8.0.4",
    "expo-sensors": "~14.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
